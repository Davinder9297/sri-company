PORT=3000
# Live server: keep production on. The server refuses to start without a real admin password and secret.
NODE_ENV=production

# --- Security (change all three before going live) ---
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@sricompany.in
ADMIN_PASSWORD=choose-a-strong-password
# Set to true ONLY when the site is served over HTTPS (secure cookies)
COOKIE_SECURE=true
# Set to 1 when running behind nginx / a hosting proxy
TRUST_PROXY=1

# Download the Google Drive box photos to this server on start (recommended)
AUTO_CACHE_IMAGES=true

# --- Optional store details (can also be edited later in Admin > Settings) ---
STORE_EMAIL=
